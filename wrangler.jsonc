{
  // The online game's relay. It serves NO file: the page stays on GitHub Pages,
  // and only comes here for a WebSocket. Both sides share the same engine and
  // the same protocol all the same, imported from src/ — that is what
  // guarantees that solo and network play by the same rules, and that solo
  // serves as the reference when an online game surprises us.
  "name": "bomberman-relais",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",

  "durable_objects": {
    "bindings": [
      {
        // One object per room code: it is what holds the shared arena.
        "name": "ROOMS",
        "class_name": "RoomObject"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      // `new_sqlite_classes` and not `new_classes`: it is the form the free plan
      // asks for, where Durable Objects are backed by SQLite.
      "new_sqlite_classes": ["SalonDurable"]
    },
    {
      // The class was renamed when the code was translated into English. A
      // rename has to be declared: without this migration, Cloudflare sees one
      // class disappear and another appear, and refuses the deployment rather
      // than guess that they are the same object.
      "tag": "v2",
      "renamed_classes": [{ "from": "SalonDurable", "to": "RoomObject" }]
    }
  ],

  "observability": {
    "enabled": true
  }
}
